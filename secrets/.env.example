# Anthropic API key for the Builder LLM (required)
#get it from https://platform.claude.com/settings/workspaces/default/keys
ANTHROPIC_API_KEY=

# Optional: override the dev server port (default 8123)
# PORT=8123

# Optional: override the SQLite DB path (default sqlite:///ai_conductor.db)
# AI_CONDUCTOR_DB=sqlite:///ai_conductor.db

# --- Real provider credentials (optional) ---
# Only needed if you pick a non-simulated provider in the session view's
# per-tool dropdown. Each var below is preflight-checked before a run starts
# (missing var -> 400 response, zero run rows created). Real SDK calls live in
# app/providers/{reach,qualify,book}.py.

# Twilio Voice (reach tool)
# Account SID + Auth Token: https://console.twilio.com
# Phone number must be one you own: https://console.twilio.com/us1/develop/phone-numbers/manage/incoming
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# HubSpot Intent (qualify tool)
# Private app access token: https://developers.hubspot.com/docs/api/private-apps
# HUBSPOT_API_KEY=

# Google Calendar (book tool)
# Path to a service-account JSON key file: https://console.cloud.google.com/apis/credentials
# Share a real calendar with that service account's email, then put its
# calendar ID here (Calendar Settings -> Integrate calendar -> Calendar ID).
# GOOGLE_CALENDAR_CREDENTIALS=
# GOOGLE_CALENDAR_ID=
