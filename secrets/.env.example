# Anthropic API key for the Builder LLM (required)
#get it from https://platform.claude.com/settings/workspaces/default/keys
ANTHROPIC_API_KEY=

# OpenAI Realtime voice (operator session + lead-call bridge)
OPENAI_API_KEY=

# Public URL Twilio can reach (e.g. an `ngrok http 8123` https URL). Only
# needed for REAL phone calls; the simulated path and the operator voice
# session work without it.
PUBLIC_BASE_URL=

# Optional: override the dev server port (default 8123)
# PORT=8123

# Optional: override the SQLite DB path (default sqlite:///ai_conductor.db)
# AI_CONDUCTOR_DB=sqlite:///ai_conductor.db

# --- Real provider credentials (optional) ---
# Only needed if you pick a non-simulated provider in the session view's
# per-tool dropdown. Each var below is preflight-checked before a run starts
# (missing var -> 400 response, zero run rows created). Real SDK calls live in
# app/providers/{reach,qualify,book}.py.

# Twilio Voice (reach tool)
# Account SID + Auth Token: https://console.twilio.com
# Phone number must be one you own: https://console.twilio.com/us1/develop/phone-numbers/manage/incoming
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# HubSpot Intent (qualify tool)
# Private app access token: https://developers.hubspot.com/docs/api/private-apps
# HUBSPOT_API_KEY=

# --- Google Calendar (book tool) ---------------------------------------------
# Only needed to book on a REAL calendar. Without these, `book` uses the
# simulated calendar and nothing below matters.

# Path to a Google credentials JSON, relative to the repo root.
# WHICH KIND you point this at decides whether the lead actually gets invited:
#
#   service-account key -> books a real event, but Google refuses to let a
#                          service account invite attendees, so the booking
#                          degrades to an attendee-less event and says so.
#
#   authorized_user     -> acts as you, so the invite really goes out. Shape:
#                          {"type": "authorized_user",
#                           "client_id": "...",
#                           "client_secret": "...",
#                           "refresh_token": "..."}
#                          Mint the refresh token ONCE against the
#                          https://www.googleapis.com/auth/calendar.events
#                          scope using your Google Cloud OAuth client, e.g. via
#                          https://developers.google.com/oauthplayground
#                          The scope granted when the token was minted is what
#                          counts — a token without calendar.events still 403s.
#
# Keep the file in secrets/ — everything there but .env.example is gitignored.
#GOOGLE_CALENDAR_CREDENTIALS=secrets/oauth-credentials.json

# Which calendar to book on.
# "primary" = your own calendar; only works with authorized_user credentials.
# With a service-account key it has no usable primary — share a calendar with
# the service account's address and put THAT calendar's ID here instead.
#GOOGLE_CALENDAR_ID=primary
